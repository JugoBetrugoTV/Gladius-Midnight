<Ui xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- Libraries -->
    <Script file="Libs\LibStub\LibStub.lua"/>
    <Include file="Libs\CallbackHandler-1.0\CallbackHandler-1.0.xml"/>
    <Script file="Libs\LibSharedMedia-3.0\LibSharedMedia-3.0.lua"/>
    <Include file="Libs\AceDB-3.0\AceDB-3.0.xml"/>
    <Include file="Libs\AceDBOptions-3.0\AceDBOptions-3.0.xml"/>
    <Include file="Libs\AceConsole-3.0\AceConsole-3.0.xml"/>
    <Include file="Libs\AceGUI-3.0\AceGUI-3.0.xml"/>
    <Include file="Libs\AceGUI-3.0-SharedMediaWidgets\widget.xml"/>
    <Include file="Libs\AceConfig-3.0\AceConfig-3.0.xml"/>
    <Script file="Libs\LibDeflate\LibDeflate.lua"/>
    <Script file="Libs\LibSerialize\LibSerialize.lua"/>

    <!-- Initialization -->
    <Script file="Init.lua"/>

    <!-- Spell Data -->
    <Script file="Data\InterruptList.lua"/>
    <Script file="Data\DRList.lua"/>
    <Script file="Data\AuraList.lua"/>
    <Script file="Data\Profiles.lua"/>

    <!-- Interrupt Module (loaded early, needed by Core) -->
    <Script file="Modules\Interrupt.lua"/>

    <!-- Core Logic -->
    <Script file="Core.lua"/>
    <Script file="Frames.lua"/>

    <!-- Modules -->
    <Script file="Modules\Racials.lua"/>
    <Script file="Modules\Dispels.lua"/>
    <Script file="Modules\DiminishingReturns.lua"/>
    <Script file="Modules\Auras.lua"/>
    <Script file="Modules\Trinkets.lua"/>
    <Script file="Modules\ModernCastbar.lua"/>
    <Script file="Modules\ImportExport.lua"/>

    <!-- Configuration -->
    <Script file="Config.lua"/>
    <Script file="SettingsUI.lua"/>

    <!-- Layouts -->
    <Script file="Layouts\BlizzArena.lua"/>
    <Script file="Layouts\BlizzRaid.lua"/>
    <Script file="Layouts\BlizzRetail.lua"/>
    <Script file="Layouts\BlizzCompact.lua"/>
    <Script file="Layouts\BlizzTourney.lua"/>
    <Script file="Layouts\BlizzTarget.lua"/>
    <Script file="Layouts\Gladiuish.lua"/>
    <Script file="Layouts\Pixelated.lua"/>
    <Script file="Layouts\Xaryu.lua"/>

    <!-- ==================== FRAME TEMPLATES ==================== -->

    <!-- DR Icon Frame -->
    <Frame name="GladiusDRTemplate" enablemouse="true" movable="true" hidden="true" virtual="true">
        <Size x="40" y="40"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="Border" file="Interface\Buttons\UI-Quickslot-Depress"/>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon">
                    <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Cooldown parentKey="Cooldown" drawBling="false" hideCountdownNumbers="false" inherits="CooldownFrameTemplate">
                <SwipeTexture>
                    <Color r="0" g="0" b="0" a="0.6"/>
                </SwipeTexture>
                <Scripts>
                    <OnLoad>
                        self:SetDrawBling(false)
                        self:SetReverse(true)
                        for _, region in next, { self:GetRegions() } do
                            if region:GetObjectType() == "FontString" then
                                self.Text = region
                                self.Text.fontFile = region:GetFont()
                            end
                        end
                        self.parent = self:GetParent()
                    </OnLoad>
                    <OnShow>
                        self.parent:GetParent():UpdateDRPositions()
                    </OnShow>
                    <OnHide>
                        self.parent:Hide()
                        self.parent.severity = 1
                        self.parent:GetParent():UpdateDRPositions()
                    </OnHide>
                </Scripts>
            </Cooldown>
            <Frame parentKey="DRTextFrame" frameStrata="HIGH" setAllPoints="true">
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="DRText" font="Interface\AddOns\GladiusMidnight\Textures\arialn.ttf" justifyH="RIGHT" justifyV="BOTTOM" outline="NORMAL">
                            <FontHeight>
                                <AbsValue val="14"/>
                            </FontHeight>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="4" y="-4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                self.severity = 1
            </OnLoad>
        </Scripts>
    </Frame>

    <!-- CastBar StatusBar Frame -->
    <StatusBar name="GladiusCastBarTemplate" mixin="CastingBarMixin,GladiusCastBarExtMixin" inherits="CastingBarFrameAnimsTemplate" enablemouse="true" movable="true" virtual="true" hidden="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.5"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="BorderShield" file="Interface\CastingBar\UI-CastingBar-Arena-Shield" hidden="true">
                    <Size x="42" y="42"/>
                    <Anchors>
                        <Anchor point="LEFT" x="-25" y="0"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Text" inherits="GameFontHighlightSmall" setAllPoints="true"/>
                <Texture parentKey="Icon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="LEFT" x="-5" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Spark" file="Interface\CastingBar\UI-CastingBar-Spark" alphaMode="ADD">
                    <Size x="1.5" y="21"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="Flash" alphaMode="ADD">
                    <Size x="256" y="64"/>
                    <Anchors>
                        <Anchor point="TOP" x="0" y="28"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
        <BarColor r="1.0" g="0.7" b="0.0"/>
        <Scripts>
            <OnLoad>
                self:OnLoad(nil, true, false)
            </OnLoad>
            <OnEvent method="OnEvent"/>
            <OnUpdate method="OnUpdate"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </StatusBar>

    <!-- Icon Frame (Trinket, Racial, Dispel) -->
    <Frame name="GladiusIconTemplate" enablemouse="true" movable="true" virtual="true">
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="1">
                <Texture parentKey="Texture" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <Cooldown parentKey="Cooldown" hideCountdownNumbers="false" inherits="CooldownFrameTemplate">
                <Scripts>
                    <OnLoad>
                        self:SetDrawBling(false)
                        for _, region in next, { self:GetRegions() } do
                            if region:GetObjectType() == "FontString" then
                                self.Text = region
                                self.Text.fontFile = region:GetFont()
                            end
                        end
                    </OnLoad>
                </Scripts>
            </Cooldown>
        </Frames>
    </Frame>

    <!-- Widget Overlay Indicator -->
    <Frame name="GladiusWidgetTemplate" enablemouse="true" movable="true" virtual="true" hidden="true">
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="Texture" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>

    <!-- Main Enemy Unit Frame -->
    <Button name="GladiusUnitFrameTemplate" frameStrata="MEDIUM" frameLevel="3" mixin="GladiusFrameMixin" hidden="true" virtual="true" inherits="SecureActionButtonTemplate">
        <Layers>
            <Layer level="BORDER" textureSubLevel="1">
                <Texture parentKey="myHealPredictionBar" inherits="MyHealPredictionBarTemplate"/>
                <Texture parentKey="otherHealPredictionBar" inherits="OtherHealPredictionBarTemplate"/>
                <Texture parentKey="totalAbsorbBar" inherits="TotalAbsorbBarTemplate">
                    <KeyValues>
                        <KeyValue key="fillTexture" value="Interface\RaidFrame\Shield-Fill" type="string"/>
                    </KeyValues>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="healAbsorbBar" inherits="HealAbsorbBarTemplate"/>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture parentKey="frameTexture" hidden="true"/>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="3">
                <FontString parentKey="Name" inherits="GameFontNormalSmall"/>
                <FontString parentKey="SpecNameText"/>
                <FontString parentKey="HealthText"/>
                <FontString parentKey="PowerText"/>
                <Texture parentKey="overAbsorbGlow" inherits="OverAbsorbGlowTemplate"/>
                <Texture parentKey="overHealAbsorbGlow" inherits="OverHealAbsorbGlowTemplate"/>
                <Texture parentKey="totalAbsorbBarOverlay" inherits="TotalAbsorbBarOverlayTemplate"/>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="7">
                <Texture parentKey="DeathIcon" atlas="DeathIcon" hidden="true">
                    <TexCoords left="0" right="1" top="0" bottom="0.5"/>
                </Texture>
                <FontString parentKey="AuraStacks" inherits="SystemFont_Shadow_Small2"/>
                <FontString parentKey="DispelStacks" inherits="SystemFont_Shadow_Small2"/>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="HealthBar" drawLayer="BORDER" useParentLevel="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="hpUnderlay" setAllPoints="true">
                            <Color r="0" g="0" b="0" a="0.6"/>
                        </Texture>
                    </Layer>
                </Layers>
            </StatusBar>
            <StatusBar parentKey="PowerBar" drawLayer="BORDER" useParentLevel="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="ppUnderlay" setAllPoints="true">
                            <Color r="0" g="0" b="0" a="0.6"/>
                        </Texture>
                    </Layer>
                </Layers>
            </StatusBar>
            <Frame parentKey="ClassIcon" frameLevel="7" enablemouse="true" movable="true">
                <Layers>
                    <Layer level="BORDER" textureSubLevel="1">
                        <Texture parentKey="Texture" setAllPoints="true"/>
                        <MaskTexture parentKey="Mask" file="Interface\CharacterFrame\TempPortraitAlphaMask" setAllPoints="true"/>
                    </Layer>
                </Layers>
                <Frames>
                    <Cooldown parentKey="Cooldown" drawLayer="BORDER" useParentLevel="true" reverse="true" hideCountdownNumbers="false" inherits="CooldownFrameTemplate">
                        <Scripts>
                            <OnLoad>
                                for _, region in next, { self:GetRegions() } do
                                    if region:GetObjectType() == "FontString" then
                                        self.Text = region
                                        self.Text.fontFile = region:GetFont()
                                    end
                                end
                                self:SetAllPoints(self:GetParent().Texture)
                                self:SetSwipeTexture(1)
                                self:SetSwipeColor(0, 0, 0, 0.55)
                                self:SetDrawBling(false)
                            </OnLoad>
                        </Scripts>
                    </Cooldown>
                </Frames>
            </Frame>
            <Frame parentKey="SpecIcon" frameLevel="8" enablemouse="true" movable="true">
                <Layers>
                    <Layer level="ARTWORK" textureSubLevel="2">
                        <Texture parentKey="Texture" setAllPoints="true"/>
                        <MaskTexture parentKey="Mask" setAllPoints="true" file="Interface\CharacterFrame\TempPortraitAlphaMask"/>
                    </Layer>
                </Layers>
            </Frame>
            <Frame parentKey="WidgetOverlay" frameStrata="HIGH" frameLevel="10" setAllPoints="true">
                <Frames>
                    <Frame parentKey="targetIndicator" inherits="GladiusWidgetTemplate">
                        <KeyValues>
                            <KeyValue key="atlas" value="TargetCrosshairs" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="focusIndicator" inherits="GladiusWidgetTemplate">
                        <KeyValues>
                            <KeyValue key="atlas" value="Waypoint-MapPin-Untracked" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="combatIndicator" inherits="GladiusWidgetTemplate">
                        <KeyValues>
                            <KeyValue key="atlas" value="Food" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="partyTarget1" inherits="GladiusWidgetTemplate">
                        <KeyValues>
                            <KeyValue key="atlas" value="GM-icon-headCount" type="string"/>
                            <KeyValue key="desaturated" value="true" type="boolean"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="partyTarget2" inherits="GladiusWidgetTemplate">
                        <KeyValues>
                            <KeyValue key="atlas" value="GM-icon-headCount" type="string"/>
                            <KeyValue key="desaturated" value="true" type="boolean"/>
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Frame parentKey="Trinket" inherits="GladiusIconTemplate"/>
            <Frame parentKey="Racial" inherits="GladiusIconTemplate"/>
            <Frame parentKey="Dispel" inherits="GladiusIconTemplate"/>
        </Frames>
        <Scripts>
            <OnEvent method="OnEvent"/>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- Main Addon Frame -->
    <Frame name="GladiusMidnight" mixin="GladiusMixin" movable="true" parent="UIParent">
        <Size x="1" y="1"/>
        <Frames>
            <Button name="GladiusEnemyFrame1" parentKey="arena1" inherits="GladiusUnitFrameTemplate" id="1">
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
            </Button>
            <Button name="GladiusEnemyFrame2" parentKey="arena2" inherits="GladiusUnitFrameTemplate" id="2"/>
            <Button name="GladiusEnemyFrame3" parentKey="arena3" inherits="GladiusUnitFrameTemplate" id="3"/>

            <Frame parentKey="ShadowsightTimer" hidden="true">
                <Size x="250" y="20"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="CENTER" x="0" y="0"/>
                            </Anchors>
                            <Color r="1.0" g="0.8" b="0.0"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnEvent method="OnEvent"/>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
