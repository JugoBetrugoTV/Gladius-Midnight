<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Data files -->
    <Script file="Data\ClassResources.lua"/>
    <Script file="Data\Racials.lua"/>

    <!-- Core addon -->
    <Script file="Core.lua"/>

    <!-- Modules -->
    <Script file="Modules\Trinkets.lua"/>
    <Script file="Modules\Racials.lua"/>

    <!-- Configuration -->
    <Script file="Config.lua"/>

    <!-- Arena Frame Template -->
    <Frame name="GladiusMidnightArenaFrameTemplate" virtual="true" enableMouse="true" movable="true">
        <Size x="200" y="50"/>
        <Layers>
            <!-- Background -->
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" setAllPoints="true">
                    <Color r="0.1" g="0.1" b="0.1" a="0.8"/>
                </Texture>
            </Layer>
            <!-- Class Icon -->
            <Layer level="ARTWORK">
                <Texture name="$parentClassIcon" parentKey="ClassIcon">
                    <Size x="44" y="44"/>
                    <Anchors>
                        <Anchor point="LEFT" x="3" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <!-- Health Bar -->
            <StatusBar name="$parentHealthBar" parentKey="HealthBar">
                <Size x="140" y="22"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="50" y="-3"/>
                </Anchors>
                <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
                <BarColor r="0.0" g="1.0" b="0.0"/>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBG" setAllPoints="true">
                            <Color r="0.2" g="0.2" b="0.2" a="0.8"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" parentKey="Text" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </StatusBar>
            <!-- Resource Bar -->
            <StatusBar name="$parentResourceBar" parentKey="ResourceBar">
                <Size x="140" y="12"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentHealthBar" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
                </Anchors>
                <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
                <BarColor r="0.0" g="0.0" b="1.0"/>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBG" setAllPoints="true">
                            <Color r="0.2" g="0.2" b="0.2" a="0.8"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" parentKey="Text" inherits="GameFontNormalSmall">
                            <Size x="0" y="12"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </StatusBar>
            <!-- Trinket Frame -->
            <Frame name="$parentTrinket" parentKey="Trinket">
                <Size x="24" y="24"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" x="4" y="8"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
                    </Layer>
                </Layers>
                <Frames>
                    <Cooldown name="$parentCooldown" parentKey="Cooldown" inherits="CooldownFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                    </Cooldown>
                </Frames>
            </Frame>
            <!-- Racial Frame -->
            <Frame name="$parentRacial" parentKey="Racial">
                <Size x="24" y="24"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentTrinket" relativePoint="BOTTOM" x="0" y="-2"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
                    </Layer>
                </Layers>
                <Frames>
                    <Cooldown name="$parentCooldown" parentKey="Cooldown" inherits="CooldownFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                    </Cooldown>
                </Frames>
            </Frame>
        </Frames>
    </Frame>

    <!-- Main Addon Frame -->
    <Frame name="GladiusMidnightFrame" parent="UIParent" hidden="true">
        <Anchors>
            <Anchor point="RIGHT" x="-100" y="0"/>
        </Anchors>
        <Frames>
            <!-- Arena1 -->
            <Frame name="GladiusMidnightArena1" inherits="GladiusMidnightArenaFrameTemplate" id="1">
                <Anchors>
                    <Anchor point="TOP" x="0" y="0"/>
                </Anchors>
            </Frame>
            <!-- Arena2 -->
            <Frame name="GladiusMidnightArena2" inherits="GladiusMidnightArenaFrameTemplate" id="2">
                <Anchors>
                    <Anchor point="TOP" relativeTo="GladiusMidnightArena1" relativePoint="BOTTOM" x="0" y="-5"/>
                </Anchors>
            </Frame>
            <!-- Arena3 -->
            <Frame name="GladiusMidnightArena3" inherits="GladiusMidnightArenaFrameTemplate" id="3">
                <Anchors>
                    <Anchor point="TOP" relativeTo="GladiusMidnightArena2" relativePoint="BOTTOM" x="0" y="-5"/>
                </Anchors>
            </Frame>
        </Frames>
    </Frame>

</Ui>
